{
  "name": "499apps-game-moon-touchdown",
  "version": "0.1.0",
  "private": true,
  "description": "Moon Touchdown for 499apps Games: fly a lander down to real Moon landing sites (real LOLA terrain) and touch down gently. Privacy-first, for kids.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "icons": "node src/kit/scripts/gen-icons.mjs --variant moon --out public/icons --favicon public/favicon.svg",
    "build": "node src/kit/scripts/gen-icons.mjs --variant moon --out public/icons --favicon public/favicon.svg && vite build && node src/kit/scripts/gen-precache.mjs --dist dist --base /games/moon-touchdown/",
    "preview": "vite preview --port 4176 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "node src/kit/scripts/scan-secrets.mjs",
    "e2e": "node src/kit/scripts/run-e2e.mjs --config playwright.config.ts --server preview --port 4176 --ready-path /games/moon-touchdown/",
    "smoke": "pnpm run e2e",
    "e2e:update": "playwright test --config playwright.config.ts --update-snapshots",
    "ci:local": "node src/kit/scripts/ci-local.mjs",
    "kit:sync": "node scripts/kit-sync.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "fast-check": "^3.23.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
